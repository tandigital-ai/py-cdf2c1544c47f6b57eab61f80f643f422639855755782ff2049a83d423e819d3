        self.nhan_tk = ctk.CTkLabel(t3, text="", anchor="w", justify="left",
                                    font=ctk.CTkFont(size=12),
                                    text_color=kho.MAU_CHU)
        self.nhan_tk.pack(fill="x", padx=12, pady=(2, 10))

    def _the(self, cha, cot, tieu_de):
        k = ctk.CTkFrame(cha, fg_color=kho.MAU_TRANG, corner_radius=10,
                         border_width=1, border_color=kho.MAU_VIEN)
        k.grid(row=0, column=cot, sticky="nsew", padx=(0 if cot == 0 else 8, 0))
        ctk.CTkLabel(k, text=tieu_de, font=ctk.CTkFont(size=12, weight="bold"),
                     text_color=kho.MAU_XANH_DAM).pack(anchor="w", padx=12,
                                                       pady=(8, 0))
        return k

    # ---------------- lay dieu kien ----------------
    def lay_dieu_kien(self):
        dk = {}
        for ma, w in self.o.items():
            gt = w.get().strip() if hasattr(w, "get") else ""
            if not gt or gt == "Tất cả":
                continue
            if ma in ("tu_ngay", "den_ngay"):
                d = kho.parse_ngay(gt)
                if d:
                    dk[ma] = d
            elif ma in ("tong_tu", "tong_den"):
                dk[ma] = kho.to_int(gt)
            else:
                dk[ma] = gt
        return dk

    def mo_ta_dieu_kien(self, dk):
        if not dk:
            return "Toàn bộ hóa đơn trong kho"
        ten = {"mst_nguoi_mua": "MST mua", "cccd_nguoi_mua": "CCCD mua",
               "ky_hieu_hoa_don": "Ký hiệu", "trang_thai": "Trạng thái",
               "tu_ngay": "Từ ngày", "den_ngay": "Đến ngày",
               "so_hoa_don": "Số HĐ", "ky_hieu_mau_so": "Mẫu số",
               "loai_hoa_don": "Loại", "ten_nguoi_ban": "Tên bán",
               "mst_nguoi_ban": "MST bán", "tu_khoa": "Từ khóa",
               "tong_tu": "Tổng từ", "tong_den": "Tổng đến"}
        p = []
        for k, v in dk.items():
            if k in ("tu_ngay", "den_ngay"):
                v = kho.fmt_ngay(v)
            elif k in ("tong_tu", "tong_den"):
                v = kho.fmt_tien(v)
            p.append("%s: %s" % (ten.get(k, k), v))
        return "   •   ".join(p)

    def xoa_dieu_kien(self):
        for ma, w in self.o.items():
            if isinstance(w, ctk.StringVar):
                w.set("Tất cả")
            else:
                w.delete(0, "end")
        self.tra_cuu()

    def ap_dung_dieu_kien(self, dk):
        for ma, w in self.o.items():
            gt = dk.get(ma, "")
            if isinstance(w, ctk.StringVar):
                w.set(gt if gt else "Tất cả")
            else:
                w.delete(0, "end")
                if gt:
                    w.insert(0, kho.fmt_ngay(gt)
                             if ma in ("tu_ngay", "den_ngay") else str(gt))
        if dk.get("ten_nguoi_ban") or dk.get("mst_nguoi_ban") \
                or dk.get("tu_khoa") or dk.get("tong_tu") or dk.get("tong_den"):
            if not self.mo_nang_cao:
                self._bat_nang_cao()
        self.tra_cuu(ghi_lich_su=False)

    # ---------------- tra cuu / ve bang ----------------
    def tra_cuu(self, ghi_lich_su=True):
        self.dieu_kien = self.lay_dieu_kien()
        try:
            self.ds_hien = kho.lay_danh_sach(self.dieu_kien, self.sap_xep,
                                             self.giam)
        except Exception as e:                   # noqa: BLE001
            log.error("Lỗi tra cứu: %s", e)
            self.app.bao("Không tra cứu được: %s" % e)
            return
        self.da_chon.clear()
        if ghi_lich_su:
            kho.ghi_lich_su(self.mo_ta_dieu_kien(self.dieu_kien),
                            self.dieu_kien, len(self.ds_hien))
        self.ve_bang(1)
        self.cap_nhat_the()

    def lam_moi(self):
        self.tra_cuu(ghi_lich_su=False)

    def _so_dong_trang(self):
        v = self.bien_trang.get()
        return 10 ** 9 if v == "Tất cả" else max(1, kho.to_int(v, 50))

    def ve_bang(self, trang=None):
        n = self._so_dong_trang()
        tong = len(self.ds_hien)
        so_trang = max(1, (tong + n - 1) // n)
        self.trang = min(max(1, trang or self.trang), so_trang)
        d1 = (self.trang - 1) * n
        phan = self.ds_hien[d1:d1 + n]

        for i in self.tv.get_children():
            self.tv.delete(i)
        for i, inv in enumerate(phan):
            kh = inv["khoa"]
            tt = inv.get("trang_thai") or "Hợp lệ"
            tags = ["tt_" + tt] if tt in kho.MAU_TRANG_THAI else []
            if i % 2:
                tags.append("le")
            if inv.get("canh_bao"):
                tags.append("canh_bao")
            self.tv.insert("", "end", iid=kh, tags=tuple(tags), values=(
                "☑" if kh in self.da_chon else "☐",
                d1 + i + 1,
                kho.fmt_ngay(inv.get("ngay_lap")),
                inv.get("so_hoa_don"),
                inv.get("ky_hieu_mau_so"),
                inv.get("ky_hieu_hoa_don"),
                inv.get("mst_nguoi_ban"),
                inv.get("ten_nguoi_ban"),
                kho.fmt_tien(inv.get("tien_hang")),
                kho.fmt_tien(inv.get("thue_gtgt")),
                kho.fmt_tien(inv.get("tong_tien")),
                tt,
                kho.THAO_TAC_TEXT))
        self.nhan_kq.configure(
            text="KẾT QUẢ TRA CỨU  (%d hóa đơn%s)"
                 % (tong, "  —  đã chọn %d" % len(self.da_chon)
                    if self.da_chon else ""))
        self.nhan_trang.configure(
            text="Hiển thị %d - %d của %d bản ghi"
                 % ((d1 + 1) if phan else 0, d1 + len(phan), tong))
        self.nhan_so_trang.configure(text="%d/%d" % (self.trang, so_trang))

    def doi_sap_xep(self, cot):
        if self.sap_xep == cot:
            self.giam = not self.giam
        else:
            self.sap_xep, self.giam = cot, True
        self.ds_hien = kho.lay_danh_sach(self.dieu_kien, self.sap_xep, self.giam)
        self.ve_bang(1)

    def cap_nhat_the(self):
        tk_ = kho.thong_ke()
        self.nhan_ht.configure(
            text="Trạng thái:  Đang đọc dữ liệu trên máy\n"
                 "Hóa đơn trong kho:  %d\nThời gian:  %s"
                 % (tk_["tong"], datetime.now().strftime("%d/%m/%Y %H:%M:%S")))
        loc = kho.thong_ke(self.dieu_kien)
        self.nhan_tk.configure(
            text="Kết quả lọc:  %d hóa đơn\nĐã tải XML:  %d   •   Chưa tải:  %d\n"
                 "Tổng thanh toán:  %s"
                 % (loc["tong"], loc["da_tai"], loc["chua_tai"],
                    kho.fmt_tien(loc["tong_tien"])))

    # ---------------- tuong tac chuot ----------------
    def bam_chuot(self, e):
        if self.tv.identify("region", e.x, e.y) != "cell":
            return None
        kh = self.tv.identify_row(e.y)
        cot = self.tv.identify_column(e.x)
        if not kh:
            return None
        chi_so = int(cot.replace("#", "")) - 1
        ma_cot = kho.COT_BANG[chi_so][0] if 0 <= chi_so < len(kho.COT_BANG) else ""
        if ma_cot == "sel":
            self.dao_chon(kh)
            return "break"
        if ma_cot == "thao_tac":
            x0 = self.tv.bbox(kh, cot)
            if x0:
                phan = (e.x - x0[0]) / max(1, x0[2])
                i = min(len(kho.THAO_TAC_NHAN) - 1,
                        int(phan * len(kho.THAO_TAC_NHAN)))
                ten = kho.THAO_TAC_NHAN[i]
                if ten == "XEM":
                    self.xem(kh)
                elif ten == "XML":
                    self.mo_xml(kh)
                elif ten == "IN":
                    self.in_html(kh)
                else:
                    self.xoa_khoa([kh])
            return "break"
        return None

    def bam_doi(self, e):
        kh = self.tv.identify_row(e.y)
        if kh:
            self.xem(kh)
        return "break"

    def menu_chuot(self, e):
        import tkinter as tk
        kh = self.tv.identify_row(e.y)
        if kh and kh not in self.tv.selection():
            self.tv.selection_set(kh)
        m = tk.Menu(self, tearoff=0)
        m.add_command(label="Xem chi tiết hóa đơn",
                      command=lambda: self.xem(kh))
        m.add_command(label="Mở tệp XML gốc", command=lambda: self.mo_xml(kh))
        m.add_command(label="In / Lưu PDF", command=lambda: self.in_html(kh))
        m.add_separator()
        m.add_command(label="Chọn / bỏ chọn dòng này",
                      command=lambda: self.dao_chon(kh))
        m.add_command(label="Chọn tất cả", command=self.chon_tat_ca)
        m.add_command(label="Bỏ chọn", command=self.bo_chon)
        m.add_separator()
        m.add_command(label="Xóa hóa đơn này", command=lambda: self.xoa_khoa([kh]))
        m.add_command(label="Xóa các dòng đã chọn (%d)" % len(self.da_chon),
                      command=self.xoa_da_chon)
        try:
            m.tk_popup(e.x_root, e.y_root)
        finally:
            m.grab_release()

    def dao_chon(self, kh):
        if kh in self.da_chon:
            self.da_chon.discard(kh)
            moi = "☐"
        else:
            self.da_chon.add(kh)
            moi = "☑"
        gt = list(self.tv.item(kh, "values"))
        gt[0] = moi
        self.tv.item(kh, values=gt)
        self.nhan_kq.configure(
            text="KẾT QUẢ TRA CỨU  (%d hóa đơn%s)"
                 % (len(self.ds_hien), "  —  đã chọn %d" % len(self.da_chon)
                    if self.da_chon else ""))

    def chon_tat_ca(self):
        for kh in self.tv.get_children():
            self.da_chon.add(kh)
        self.ve_bang(self.trang)

    def bo_chon(self):
        self.da_chon.clear()
        self.ve_bang(self.trang)

    # ---------------- hanh dong ----------------
    def _inv(self, kh):
        return kho.lay_chi_tiet(kh)

    def ds_chon(self):
        """Hoa don dang chon; neu khong chon gi thi lay dong dang to sang."""
        kh = list(self.da_chon) or list(self.tv.selection())
        return [x for x in (kho.lay_chi_tiet(k) for k in kh) if x]

    def xem(self, kh):
        inv = self._inv(kh)
        if inv:
            invoice_view.mo_cua_so(self.app, inv)

    def mo_xml(self, kh):
        inv = self._inv(kh)
        d = (inv or {}).get("duong_dan_xml") or ""
        if not exporter.mo_duong_dan(d):
            self.app.bao("Không tìm thấy tệp XML gốc của hóa đơn này:\n%s"
                         % (d or "(chưa có đường dẫn)"))

    def in_html(self, kh):
        inv = self._inv(kh)
        if not inv:
            return
        import invoice_render
        import tempfile
        try:
            d = os.path.join(tempfile.gettempdir(),
                             invoice_render.ten_tep_html(inv))
            invoice_render.luu_html(inv, duong_dan=d)
        except OSError as e:
            self.app.bao("Không tạo được bản thể hiện: %s" % e)
            return
        exporter.mo_duong_dan(d)
        kho.cap_nhat_truong(kh, da_tai=1)

    def tai_xml(self):
        ds = self.ds_chon()
        if not ds:
            self.app.bao("Hãy chọn ít nhất một hóa đơn (ô vuông ở cột đầu).")
            return
        t = filedialog.askdirectory(title="Chọn thư mục lưu tệp XML")
        if not t:
            return
        ok, thieu = exporter.chep_nhieu_xml(ds, t)
        if self.app.cau_hinh.get("mo_sau_khi_xuat", True) and ok:
            exporter.mo_duong_dan(t)
        self.app.bao("Đã chép %d tệp XML vào:\n%s\n\n"
                     "%d hóa đơn không có tệp XML gốc trên máy."
                     % (len(ok), t, len(thieu)))

    def tai_pdf(self):
        ds = self.ds_chon()
        if not ds:
            self.app.bao("Hãy chọn ít nhất một hóa đơn (ô vuông ở cột đầu).")
            return
        t = filedialog.askdirectory(title="Chọn thư mục lưu bản thể hiện")
        if not t:
            return
        kq = exporter.xuat_nhieu_html(ds, t)
        for inv in ds:
            kho.cap_nhat_truong(inv["khoa"], da_tai=1)
        if self.app.cau_hinh.get("mo_sau_khi_xuat", True) and kq:
            exporter.mo_duong_dan(t)
        self.app.bao("Đã xuất %d bản thể hiện HTML vào:\n%s\n\n"
                     "Mở tệp rồi nhấn Ctrl + P → chọn “Microsoft Print to PDF” "
                     "để lưu thành PDF." % (len(kq), t))

    def xuat_excel(self):
        if not self.ds_hien:
            self.app.bao("Chưa có kết quả nào để xuất.")
            return
        t = filedialog.asksaveasfilename(
            title="Lưu bảng kê Excel", defaultextension=".xlsx",
            filetypes=[("Bảng tính Excel", "*.xlsx")],
            initialfile="BangKeHoaDon_%s.xlsx"
                        % datetime.now().strftime("%Y%m%d_%H%M%S"),
            initialdir=self.app.cau_hinh.get("thu_muc_xuat") or os.getcwd())
        if not t:
            return
        try:
            d = exporter.xuat_excel(
                self.ds_hien, duong_dan=t,
                tieu_de_bang="Điều kiện: %s — Kết xuất lúc %s"
                             % (self.mo_ta_dieu_kien(self.dieu_kien),
                                datetime.now().strftime("%d/%m/%Y %H:%M")))
        except Exception as e:                   # noqa: BLE001
            self.app.bao("Không xuất được Excel: %s" % e)
            return
        if self.app.cau_hinh.get("mo_sau_khi_xuat", True):
            exporter.mo_duong_dan(d)
        self.app.bao("Đã xuất %d dòng ra:\n%s" % (len(self.ds_hien), d))

    # ---------------- xoa ----------------
    def xoa_khoa(self, danh_sach_khoa):
        ds = [x for x in (kho.lay_chi_tiet(k) for k in danh_sach_khoa) if x]
        if not ds:
            return
        mo_ta = "\n".join(
            "• %s  số %s  ngày %s  —  %s  —  %s"
            % (i.get("ky_hieu_day_du"), i.get("so_hoa_don"),
               kho.fmt_ngay(i.get("ngay_lap")), (i.get("ten_nguoi_ban") or "")[:38],
               kho.fmt_tien(i.get("tong_tien"))) for i in ds[:40])
        if len(ds) > 40:
            mo_ta += "\n… và %d hóa đơn khác." % (len(ds) - 40)
        if self.app.cau_hinh.get("xac_nhan_truoc_khi_xoa", True):
            h = HopXacNhanXoa(self.app, len(ds), mo_ta)
            self.app.wait_window(h)
            if not h.ket_qua or not h.ket_qua[0]:
                return
            xoa_tep = h.ket_qua[1]
        else:
            xoa_tep = False
        n, nt = kho.xoa([i["khoa"] for i in ds], xoa_tep)
        self.da_chon.clear()
        self.tra_cuu(ghi_lich_su=False)
        self.app.bao("Đã xóa %d hóa đơn khỏi kho%s."
                     % (n, " và %d tệp XML" % nt if nt else ""))

    def xoa_da_chon(self):
        kh = list(self.da_chon) or list(self.tv.selection())
        if not kh:
            self.app.bao("Chưa chọn hóa đơn nào để xóa.\n\n"
                         "Hãy nhấp ô vuông ở cột đầu tiên, hoặc bấm [XÓA] "
                         "ở cột Thao tác để xóa một dòng.")
            return
        self.xoa_khoa(kh)

    def xoa_ket_qua_loc(self):
        if not self.ds_hien:
            self.app.bao("Không có kết quả nào đang hiển thị.")
            return
        self.xoa_khoa([i["khoa"] for i in self.ds_hien])

    def chon_thu_muc(self):
        t = filedialog.askdirectory(title="Chọn thư mục lưu trữ hóa đơn",
                                    initialdir=self.o_thu_muc.get() or "/")
        if not t:
            return
        t = os.path.normpath(t)
        self.o_thu_muc.delete(0, "end")
        self.o_thu_muc.insert(0, t)
        self.app.cau_hinh["thu_muc_luu_tru"] = t
        kho.ghi_cau_hinh(self.app.cau_hinh)


