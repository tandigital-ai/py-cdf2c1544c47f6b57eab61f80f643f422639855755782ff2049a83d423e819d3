        self._nhan(cha, r, c, nhan)
        bien = ctk.StringVar(value=ds[0])
        ctk.CTkOptionMenu(cha, values=ds, variable=bien, height=32,
                          fg_color=kho.MAU_TRANG, button_color=kho.MAU_XANH,
                          button_hover_color=kho.MAU_XANH_DAM,
                          text_color=kho.MAU_CHU,
                          dropdown_fg_color=kho.MAU_TRANG,
                          dropdown_text_color=kho.MAU_CHU
                          ).grid(row=r, column=c + 1, sticky="ew",
                                 padx=(0, 16), pady=5)
        self.o[ma] = bien
        return bien

    def _o_ngay(self, cha, r, c, nhan, ma):
        self._nhan(cha, r, c, nhan)
        k = ctk.CTkFrame(cha, fg_color="transparent")
        k.grid(row=r, column=c + 1, sticky="ew", padx=(0, 16), pady=5)
        o = ctk.CTkEntry(k, height=32, placeholder_text="dd/mm/yyyy",
                         fg_color=kho.MAU_TRANG, border_color=kho.MAU_VIEN,
                         text_color=kho.MAU_CHU)
        o.pack(side="left", fill="x", expand=True)
        ctk.CTkButton(k, text="📅", width=36, height=32, fg_color=kho.MAU_XANH,
                      command=lambda: LichChon(self.app, o)).pack(side="left",
                                                                  padx=(4, 0))
        self.o[ma] = o
        return o

