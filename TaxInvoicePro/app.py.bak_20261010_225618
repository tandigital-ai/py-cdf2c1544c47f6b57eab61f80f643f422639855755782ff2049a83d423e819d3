        self.mo_nang_cao = not self.mo_nang_cao
        if self.mo_nang_cao:
            self.khung_nc.pack(fill="x", pady=(2, 0))
            self.nut_nc.configure(text="▲  Thu gọn")
        else:
            self.khung_nc.pack_forget()
            self.nut_nc.configure(text="▼  Nâng cao")

    # ---------------- bang ket qua ----------------
