                     font=ctk.CTkFont(size=12),
                     text_color=kho.MAU_CHU).grid(row=r, column=c, sticky="w",
                                                  padx=(0, 6), pady=5)

    def _o_nhap(self, cha, r, c, nhan, ma, goi_y="", luoi=None):
        self._nhan(cha, r, c, nhan)
        o = ctk.CTkEntry(cha, height=32, placeholder_text=goi_y,
                         fg_color=kho.MAU_TRANG, border_color=kho.MAU_VIEN,
                         text_color=kho.MAU_CHU)
        o.grid(row=r, column=c + 1, sticky="ew", padx=(0, 16), pady=5)
        self.o[ma] = o
        return o

