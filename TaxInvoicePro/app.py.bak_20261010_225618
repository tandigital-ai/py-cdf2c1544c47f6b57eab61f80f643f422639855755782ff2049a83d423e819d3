        self.cau_hinh = kho.doc_cau_hinh()
        self.title("%s %s — %s" % (kho.APP_NAME, kho.APP_VERSION,
                                   kho.OFFLINE_TEXT))
        self.geometry("1280x800")
        self.minsize(1100, 680)
        self.configure(fg_color=kho.MAU_NEN)
        self._kieu_bang()
        self._thanh_tren()
        than = ctk.CTkFrame(self, fg_color=kho.MAU_NEN)
        than.pack(fill="both", expand=True)
        self._cot_trai(than)
        self.vung = ctk.CTkFrame(than, fg_color=kho.MAU_NEN)
        self.vung.pack(side="left", fill="both", expand=True)
        self._chan_trang()
        self.man_hinh = {}
        self.hien_tai = None
        self.hien_man_hinh("tra_cuu")
        self.protocol("WM_DELETE_WINDOW", self.dong)

    # ---------------- kieu ----------------
    def _kieu_bang(self):
        s = ttk.Style()
        try:
            s.theme_use("clam")
        except Exception:                        # noqa: BLE001
            pass
        s.configure("Invoice.Treeview", background=kho.MAU_TRANG,
                    fieldbackground=kho.MAU_TRANG, foreground=kho.MAU_CHU,
                    rowheight=27, borderwidth=0, font=("Segoe UI", 10))
        s.configure("Invoice.Treeview.Heading", background=kho.MAU_XANH,
                    foreground="#FFFFFF", relief="flat",
                    font=("Segoe UI", 10, "bold"), padding=(2, 5))
        s.map("Invoice.Treeview.Heading",
              background=[("active", kho.MAU_XANH_DAM)])
        s.map("Invoice.Treeview", background=[("selected", "#CFE3FA")],
              foreground=[("selected", kho.MAU_CHU)])
        s.configure("Xem.Treeview", background=kho.MAU_TRANG,
                    fieldbackground=kho.MAU_TRANG, foreground=kho.MAU_CHU,
                    rowheight=25, font=("Segoe UI", 10))
        s.configure("Xem.Treeview.Heading", background="#E8F1FC",
                    foreground=kho.MAU_XANH_DAM, relief="flat",
                    font=("Segoe UI", 9, "bold"))

    # ---------------- thanh tren ----------------
    def _thanh_tren(self):
        t = ctk.CTkFrame(self, fg_color=kho.MAU_XANH, corner_radius=0, height=56)
        t.pack(fill="x")
        t.pack_propagate(False)
        ctk.CTkLabel(t, text="◆  " + kho.APP_NAME,
                     font=ctk.CTkFont(size=19, weight="bold"),
                     text_color="#FFFFFF").pack(side="left", padx=(16, 8))
        ctk.CTkLabel(t, text=kho.APP_VERSION, fg_color="#0D47A1",
                     corner_radius=10, width=52, height=22,
                     font=ctk.CTkFont(size=11, weight="bold"),
                     text_color="#FFFFFF").pack(side="left")
        ctk.CTkLabel(t, text=kho.SLOGAN, font=ctk.CTkFont(size=12),
                     text_color="#CFE3FA").pack(side="left", padx=14)
        ctk.CTkButton(t, text="%s ▾" % self.cau_hinh.get("nguoi_dung",
                                                         "Kế toán"),
                      width=140, height=32, fg_color="#0D47A1",
                      hover_color="#08306B", corner_radius=6,
                      font=ctk.CTkFont(size=12),
                      command=lambda: self.hien_man_hinh("lien_he")
                      ).pack(side="right", padx=(6, 16))
        ctk.CTkButton(t, text="Cài đặt", width=90, height=32,
                      fg_color="#0D47A1", hover_color="#08306B",
                      corner_radius=6, font=ctk.CTkFont(size=12),
                      command=lambda: self.hien_man_hinh("thiet_lap")
                      ).pack(side="right", padx=6)
        ctk.CTkLabel(t, text="●  " + kho.OFFLINE_TEXT, fg_color="#0D47A1",
                     corner_radius=16, height=30, width=390,
                     font=ctk.CTkFont(size=12, weight="bold"),
                     text_color="#FFFFFF").pack(side="right", padx=10)

    # ---------------- cot trai ----------------
    def _cot_trai(self, cha):
        c = ctk.CTkFrame(cha, fg_color=kho.MAU_XANH_DAM, corner_radius=0,
                         width=200)
        c.pack(side="left", fill="y")
        c.pack_propagate(False)
        self.nut_menu = {}
        for ma, ten in kho.MENU_TRAI:
            b = ctk.CTkButton(c, text=ten, anchor="w", height=42, width=200,
                              corner_radius=0, fg_color="transparent",
                              hover_color="#1565C0", text_color="#DCE9F8",
                              font=ctk.CTkFont(size=13),
                              command=lambda m=ma: self.hien_man_hinh(m))
            b.pack(fill="x")
            self.nut_menu[ma] = b
        k = ctk.CTkFrame(c, fg_color="#1565C0", corner_radius=10)
        k.pack(side="bottom", fill="x", padx=12, pady=16)
        ctk.CTkLabel(k, text="HÓA ĐƠN\nĐIỆN TỬ",
                     font=ctk.CTkFont(size=15, weight="bold"),
                     text_color="#FFFFFF").pack(pady=(12, 2))
        ctk.CTkLabel(k, text="Đồng hành\ncùng kế toán Việt",
                     font=ctk.CTkFont(size=11), text_color="#CFE3FA"
                     ).pack(pady=(0, 12))

    # ---------------- chan trang ----------------
    def _chan_trang(self):
        c = ctk.CTkFrame(self, fg_color=kho.MAU_TRANG, corner_radius=0,
                         height=30, border_width=1, border_color=kho.MAU_VIEN)
        c.pack(fill="x", side="bottom")
        c.pack_propagate(False)
        ctk.CTkLabel(c, text="Phần mềm hỗ trợ tra cứu và lưu trữ hóa đơn điện "
                             "tử đã có trên máy — sử dụng cho mục đích công "
                             "việc hợp pháp",
                     font=ctk.CTkFont(size=11), text_color=kho.MAU_XAM
                     ).pack(side="left", padx=14)
        ctk.CTkLabel(c, text="Cập nhật: %s" % kho.NGAY_CAP_NHAT,
                     font=ctk.CTkFont(size=11), text_color=kho.MAU_XAM
                     ).pack(side="right", padx=14)
        ctk.CTkLabel(c, text="Tác giả: %s    Điện thoại: %s"
                     % (kho.TAC_GIA, kho.DIEN_THOAI),
                     font=ctk.CTkFont(size=11, weight="bold"),
                     text_color=kho.MAU_XANH_DAM).pack(side="right", padx=14)
        ctk.CTkLabel(c, text="Phiên bản %s" % kho.APP_VERSION.lstrip("v"),
                     font=ctk.CTkFont(size=11), text_color=kho.MAU_XAM
                     ).pack(side="right", padx=14)

    # ---------------- dieu huong ----------------
    def hien_man_hinh(self, ma):
        lop = {"trang_chu": man_hinh_phu.TrangChu,
               "tra_cuu": ManHinhTraCuu,
               "quan_ly_tep": man_hinh_phu.QuanLyTep,
               "lich_su": man_hinh_phu.LichSu,
               "thiet_lap": man_hinh_phu.ThietLap,
               "huong_dan": man_hinh_phu.HuongDan,
               "lien_he": man_hinh_phu.LienHe}.get(ma)
        if lop is None:
            return
        if ma == "thiet_lap" and ma in self.man_hinh:
            self.man_hinh[ma].destroy()
            del self.man_hinh[ma]
        if ma not in self.man_hinh:
            self.man_hinh[ma] = lop(self.vung, self)
        if self.hien_tai is not None:
            self.hien_tai.pack_forget()
        self.hien_tai = self.man_hinh[ma]
        self.hien_tai.pack(fill="both", expand=True)
        lam_moi = getattr(self.hien_tai, "lam_moi", None)
        if callable(lam_moi) and ma != "tra_cuu":
            lam_moi()
        for m, b in self.nut_menu.items():
            b.configure(fg_color=kho.MAU_XANH if m == ma else "transparent",
                        text_color="#FFFFFF" if m == ma else "#DCE9F8",
                        font=ctk.CTkFont(size=13,
                                         weight="bold" if m == ma else "normal"))

    def ap_dung_dieu_kien(self, dk):
        self.hien_man_hinh("tra_cuu")
        self.man_hinh["tra_cuu"].ap_dung_dieu_kien(dk or {})

    def lam_moi_tat_ca(self):
        for ma, mh in self.man_hinh.items():
            f = getattr(mh, "lam_moi", None)
            if callable(f):
                try:
                    f()
                except Exception as e:           # noqa: BLE001
                    log.warning("Lỗi làm mới %s: %s", ma, e)

    # ---------------- hop thoai ----------------
    def bao(self, noi_dung, tieu_de="Thông báo"):
        h = HopThoai(self, tieu_de, noi_dung)
        self.wait_window(h)

    def hoi(self, noi_dung, tieu_de="Xác nhận"):
        h = HopThoai(self, tieu_de, noi_dung, nut=("Hủy bỏ", "Đồng ý"))
        self.wait_window(h)
        return h.ket_qua == "Đồng ý"

    # ---------------- nap du lieu ----------------
    def mo_hop_nap(self):
        h = HopChonNguon(self)
        self.wait_window(h)
        ma = h.ket_qua
        if not ma:
            return
        bd = self.cau_hinh.get("thu_muc_nap_gan_nhat") or os.path.expanduser("~")
        if ma == "zip":
            d = filedialog.askopenfilename(
                title="Chọn gói ZIP tải từ Cổng Thuế", initialdir=bd,
                filetypes=[("Gói nén ZIP", "*.zip"), ("Tất cả", "*.*")])
            if not d:
                return
            self._ghi_nho(os.path.dirname(d))
            bc = importer.nap_zip(d)
        elif ma == "tep":
            ds = filedialog.askopenfilenames(
                title="Chọn tệp XML hóa đơn", initialdir=bd,
                filetypes=[("Tệp XML hóa đơn", "*.xml"), ("Tất cả", "*.*")])
            if not ds:
                return
            self._ghi_nho(os.path.dirname(ds[0]))
            bc = importer.nap_danh_sach_tep(list(ds), "Chọn từng tệp XML",
                                            duong_dan=os.path.dirname(ds[0]))
        else:
            d = filedialog.askdirectory(title="Chọn thư mục chứa tệp XML",
                                        initialdir=bd)
            if not d:
                return
            self._ghi_nho(d)
            bc = importer.nap_thu_muc(d, de_quy=(ma == "de_quy"))

        tom = importer.tom_tat(bc)
        ct = "\n".join(bc["chi_tiet"][:60])
        if len(bc["chi_tiet"]) > 60:
            ct += "\n… và %d dòng khác (xem mục Quản lý tệp đã tải)." \
                  % (len(bc["chi_tiet"]) - 60)
        h2 = HopThoai(self, "Kết quả nạp hóa đơn",
                      tom + "\n\n" + ct, rong=720, cao=520,
                      mau_chinh=kho.MAU_LUC if bc["them"] else kho.MAU_CAM)
        self.wait_window(h2)

        mh = self.man_hinh.get("tra_cuu")
        if bc["them"] and mh is not None:
            # bo moi dieu kien loc de hoa don vua nap chac chan hien ra
            for _ma, w in mh.o.items():
                if isinstance(w, ctk.StringVar):
                    w.set("Tất cả")
                else:
                    w.delete(0, "end")
        self.hien_man_hinh("tra_cuu")
        self.man_hinh["tra_cuu"].tra_cuu(ghi_lich_su=False)
        if bc["them"]:
            self.man_hinh["tra_cuu"].da_chon = set(bc["khoa_moi"])
            self.man_hinh["tra_cuu"].ve_bang(1)
        self.lam_moi_tat_ca()

    def _ghi_nho(self, thu_muc):
        self.cau_hinh["thu_muc_nap_gan_nhat"] = thu_muc or ""
        kho.ghi_cau_hinh(self.cau_hinh)

    # ---------------- dong ----------------
    def dong(self):
        try:
            mh = self.man_hinh.get("tra_cuu")
            if mh is not None:
                self.cau_hinh["so_ban_ghi_moi_trang"] = mh.bien_trang.get()
                self.cau_hinh["thu_muc_luu_tru"] = mh.o_thu_muc.get().strip() \
                    or self.cau_hinh.get("thu_muc_luu_tru")
            kho.ghi_cau_hinh(self.cau_hinh)
            kho.sao_luu("thoat")
            kho.dong_ket_noi()
            log.info("Đóng ứng dụng.")
        except Exception as e:                   # noqa: BLE001
            log.warning("Lỗi khi đóng: %s", e)
        self.destroy()


# ======================================================================
def main():
    try:
        kho.khoi_tao()
    except Exception as e:                       # noqa: BLE001
        print("Không khởi tạo được cơ sở dữ liệu: %s" % e)
        traceback.print_exc()
        return 1
    try:
        UngDung().mainloop()
    except Exception as e:                       # noqa: BLE001
        log.error("Lỗi không mong muốn: %s\n%s", e, traceback.format_exc())
        print("Đã xảy ra lỗi: %s\nXem chi tiết trong logs\\app.log" % e)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
