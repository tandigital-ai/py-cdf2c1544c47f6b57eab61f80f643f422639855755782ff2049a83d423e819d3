class LichChon(ctk.CTkToplevel):
    """Lich nho de chon ngay, tra ve chuoi dd/mm/yyyy qua o nhap."""

    def __init__(self, cha, o_nhap):
        super().__init__(cha)
        self.o = o_nhap
        self.title("Chọn ngày")
        self.geometry("290x300")
        self.resizable(False, False)
        self.configure(fg_color=kho.MAU_TRANG)
        d = kho.parse_ngay(o_nhap.get())
        hom_nay = date.today()
        if d:
            y, m, _x = (int(v) for v in d.split("-"))
        else:
            y, m = hom_nay.year, hom_nay.month
        self.nam, self.thang = y, m
        self.dau = ctk.CTkFrame(self, fg_color=kho.MAU_XANH, corner_radius=0)
        self.dau.pack(fill="x")
        ctk.CTkButton(self.dau, text="◀", width=34, height=30, fg_color=kho.MAU_XANH,
                      hover_color=kho.MAU_XANH_DAM,
                      command=lambda: self._chuyen(-1)).pack(side="left")
        self.nhan = ctk.CTkLabel(self.dau, text="", text_color="#FFFFFF",
                                 font=ctk.CTkFont(size=13, weight="bold"))
        self.nhan.pack(side="left", expand=True)
        ctk.CTkButton(self.dau, text="▶", width=34, height=30, fg_color=kho.MAU_XANH,
                      hover_color=kho.MAU_XANH_DAM,
                      command=lambda: self._chuyen(1)).pack(side="right")
        self.luoi = ctk.CTkFrame(self, fg_color=kho.MAU_TRANG)
        self.luoi.pack(fill="both", expand=True, padx=8, pady=6)
        t = ctk.CTkFrame(self, fg_color="transparent")
        t.pack(fill="x", padx=8, pady=(0, 8))
        ctk.CTkButton(t, text="Hôm nay", width=100, height=30,
                      fg_color=kho.MAU_LUC,
                      command=self._hom_nay).pack(side="left")
        ctk.CTkButton(t, text="Xóa ngày", width=100, height=30,
                      fg_color="#6B7A8C", command=self._xoa).pack(side="right")
        self._ve()
        self.after(120, self.lift)
        self.after(140, self.grab_set)

    def _chuyen(self, b):
        self.thang += b
        if self.thang < 1:
            self.thang, self.nam = 12, self.nam - 1
        elif self.thang > 12:
            self.thang, self.nam = 1, self.nam + 1
        self._ve()

    def _ve(self):
        for w in self.luoi.winfo_children():
            w.destroy()
        self.nhan.configure(text="Tháng %02d / %d" % (self.thang, self.nam))
        for i, t in enumerate(["T2", "T3", "T4", "T5", "T6", "T7", "CN"]):
            ctk.CTkLabel(self.luoi, text=t, width=34,
                         font=ctk.CTkFont(size=11, weight="bold"),
                         text_color=kho.MAU_XAM).grid(row=0, column=i, pady=2)
        hn = date.today()
        for r, tuan in enumerate(calendar.monthcalendar(self.nam, self.thang), 1):
            for c, ng in enumerate(tuan):
                if ng == 0:
                    continue
                la_hn = (ng == hn.day and self.thang == hn.month
                         and self.nam == hn.year)
                ctk.CTkButton(
                    self.luoi, text=str(ng), width=34, height=28,
                    corner_radius=4,
                    fg_color=kho.MAU_XANH if la_hn else "#EEF3F9",
                    text_color="#FFFFFF" if la_hn else kho.MAU_CHU,
                    hover_color="#C9DCF2",
                    font=ctk.CTkFont(size=12),
                    command=lambda n=ng: self._chon(n)).grid(row=r, column=c,
                                                             padx=1, pady=1)

    def _chon(self, ngay):
        self.o.delete(0, "end")
        self.o.insert(0, "%02d/%02d/%d" % (ngay, self.thang, self.nam))
        self.grab_release()
        self.destroy()

    def _hom_nay(self):
        h = date.today()
        self.nam, self.thang = h.year, h.month
        self._chon(h.day)

    def _xoa(self):
        self.o.delete(0, "end")
        self.grab_release()
        self.destroy()


