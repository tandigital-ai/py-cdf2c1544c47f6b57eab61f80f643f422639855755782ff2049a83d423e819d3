                     wraplength=rong - 80, font=ctk.CTkFont(size=12),
                     text_color=kho.MAU_CHU).pack(fill="x", padx=6, pady=6)
        t = ctk.CTkFrame(self, fg_color="transparent")
        t.pack(fill="x", padx=20, pady=(0, 14))
